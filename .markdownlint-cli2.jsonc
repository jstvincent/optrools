{
  // Lint all Markdown files in the repo.
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**"],
  "config": {
    // This repo contains many generated/archived Markdown files (diff logs) whose
    // formatting doesn't match markdownlint's defaults. Keep linting enabled, but
    // disable the noisiest style rules so `npm run lint` is usable in Codespaces.
    "MD007": false,
    "MD012": false,
    "MD013": false,
    "MD022": false,
    "MD025": false,
    "MD026": false,
    "MD032": false,
    "MD033": false,
    "MD038": false,
    "MD047": false,
    "MD058": false,
    "MD060": false
  }
}
